# Template only: choose the actual reviewed commit, IDs, policy, routes, and customer inputs.
# This is inert KEY=VALUE data for PID1 LoadCredential; never source it into root's shell.
WALLET_KERNEL_MODE=cdp-testnet
WALLET_KERNEL_DB_FILE=/var/lib/wallet-kernel/authority/kernel.sqlite
WALLET_KERNEL_RECEIPT_KEY_FILE=/var/lib/wallet-kernel/authority/receipt-key.json
WALLET_KERNEL_OPERATOR_TOKEN_FILE=/var/lib/wallet-kernel/authority/operator-token.json
WALLET_KERNEL_TRUSTED_ANCESTOR=/
WALLET_KERNEL_EXPECTED_AGENT_UID=502
WALLET_KERNEL_EXPECTED_AGENT_GID=502
WALLET_KERNEL_POLICY_FILE=/opt/wallet-kernel/releases/0000000000000000000000000000000000000000/pilot-policy.json
WALLET_KERNEL_ROUTE_FILE=/opt/wallet-kernel/releases/0000000000000000000000000000000000000000/pilot-routes.json
WALLET_KERNEL_PORT=8402
WALLET_KERNEL_OPERATOR_PORT=8405
WALLET_KERNEL_OPERATOR_SOCKET_FILE=/run/wallet-kernel/admin.sock
WALLET_KERNEL_ENROLLMENT_INBOX=/var/lib/wallet-agent/enrollment
WALLET_KERNEL_AGENT_RUN_OUTBOX=/var/lib/wallet-kernel/agent-run-outbox
WALLET_KERNEL_RELEASE_ROOT=/opt/wallet-kernel/releases/0000000000000000000000000000000000000000
WALLET_KERNEL_RELEASE_MANIFEST=/opt/wallet-kernel/releases/0000000000000000000000000000000000000000/manifest.json
WALLET_KERNEL_SERVICE_DEFINITION_FILE=/etc/systemd/system/wallet-kernel.service
WALLET_KERNEL_SOCKET_DEFINITION_FILE=/etc/systemd/system/wallet-kernel-console.socket
WALLET_KERNEL_ENV_FILE=/etc/wallet-kernel/kernel.env
WALLET_KERNEL_EVIDENCE_ROOT=/var/lib/wallet-kernel/evidence
WALLET_KERNEL_ISOLATION_REPORT_FILE=/run/wallet-kernel/isolation.json
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_WALLET_NAME=
WALLET_KERNEL_BASE_SEPOLIA_RPC_URL=
